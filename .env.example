# Matrimony Geo-Search API Configuration

# Application Settings
APP_NAME="Matrimony Geo-Search API"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# MongoDB Local Configuration (Target)
MONGO_URI="mongodb://localhost:27017/matrimony"
MONGO_DB_NAME="matrimony"
MONGO_COLLECTION_NAME="profiles"

# MongoDB Production Configuration (Source)
# Replace with your actual AWS EC2 MongoDB connection string:
# Format: mongodb://username:password@ec2-public-ip:port/dbname?authSource=dbname
PROD_MONGO_URI="mongodb://username:password@your-ec2-ip:27017/matrimony"
